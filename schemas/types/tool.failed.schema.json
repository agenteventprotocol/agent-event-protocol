{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aep://schemas/0.1/types/tool.failed.schema.json",
  "title": "AEP payload: tool.failed",
  "type": "object",
  "properties": {
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "x-aep-capture": "metadata"
        },
        "call_id": {
          "type": "string",
          "x-aep-capture": "metadata"
        }
      },
      "x-aep-capture": "metadata",
      "required": [
        "name"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "x-aep-capture": "metadata"
        },
        "message": {
          "type": "string",
          "x-aep-capture": "redacted"
        }
      },
      "x-aep-capture": "metadata"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    }
  },
  "required": [
    "tool",
    "error"
  ]
}
