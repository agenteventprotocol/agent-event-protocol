    },
    "forgotten": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    },
    "gen_ai.usage.input_tokens": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    },
    "gen_ai.usage.output_tokens": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    }
  }
