{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aep://schemas/0.1/types/tool.completed.schema.json",
  "title": "AEP payload: tool.completed",
  "type": "object",
  "properties": {
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "x-aep-capture": "metadata"
        },
        "call_id": {
          "type": "string",
          "x-aep-capture": "metadata"
        }
      },
      "x-aep-capture": "metadata",
      "required": [
        "name"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    },
    "status": {
      "type": "string",
      "x-aep-capture": "metadata"
    },
    "result_digest": {
      "type": "string",
      "x-aep-capture": "metadata"
    },
    "result_redacted": {
      "type": [
        "object",
        "string"
      ],
      "x-aep-capture": "redacted"
    },
    "result": {
      "type": [
        "object",
        "string"
      ],
      "x-aep-capture": "full"
    },
    "gen_ai.usage.input_tokens": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    },
    "gen_ai.usage.output_tokens": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    },
    "cost": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "x-aep-capture": "metadata"
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "x-aep-capture": "metadata"
        },
        "prompt": {
          "type": "number",
          "minimum": 0,
          "x-aep-capture": "metadata"
        },
        "completion": {
          "type": "number",
          "minimum": 0,
          "x-aep-capture": "metadata"
        },
        "cache": {
          "type": "number",
          "minimum": 0,
          "x-aep-capture": "metadata"
        },
        "reasoning": {
          "type": "number",
          "minimum": 0,
          "x-aep-capture": "metadata"
        }
      },
      "required": [
        "currency"
      ],
      "x-aep-capture": "metadata"
    }
  },
  "required": [
    "tool"
  ]
}
