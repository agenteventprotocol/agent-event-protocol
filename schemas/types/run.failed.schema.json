{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aep://schemas/0.1/types/run.failed.schema.json",
  "title": "AEP payload: run.failed",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "x-aep-capture": "metadata"
    },
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "x-aep-capture": "metadata"
        },
        "message": {
          "type": "string",
          "x-aep-capture": "redacted"
        }
      },
      "x-aep-capture": "metadata"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "x-aep-capture": "metadata"
    }
  },
  "required": [
    "reason"
  ]
}
