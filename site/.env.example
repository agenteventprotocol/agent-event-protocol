# Docs site build configuration.
#
#   cp .env.example .env
#
# Every variable is optional and the build works with none of them set. Values
# in the real environment override this file, so CI can set them as workflow
# variables without a local .env shadowing them.

# Absolute origin the site is published under, with no trailing slash.
#
# Sets <link rel="canonical"> and <meta property="og:url"> on every page. Leave
# it unset and both tags are omitted rather than emitted with a guessed host —
# a wrong canonical is worse than none, because search engines will honour it.
# The origin-independent link-preview tags (og:title, og:description,
# twitter:card, ...) are emitted either way.
#
# SITE_URL=https://agenteventprotocol.io

# Port for `npm run serve` and `npm run dev`. Defaults to 4173.
#
# PORT=4173
