{
 "$comment": "AEP-0002 Annex A machine-usable fixture for the Codex OTel-inbound channel (design record: the spec repo docs/components/bridge-otlp-inbound-design.md). Each entry pins the pure record->event mapping over FLATTENED attributes at the default metadata ceiling, in BOTH modes: companion (the default — everything in the channel-visible x.codex.otel.* family, core types never emitted) and primary (hook-less deployments — the core subset). Keys follow the vendor-documented examples where observed; tool/decision keys are representative per the vendor descriptions and are refined at live validation. Envelope identity (conversation.id -> session, agent codex, no runs synthesized) is receiver wiring, pinned by the reference smoke.",
 "identity": {
  "session_from": "conversation.id",
  "run_from": null,
  "$comment": "runs are deliberately not synthesized: async export pipelines cannot pair run boundaries honestly (design note)"
 },
 "records": {
  "conversation_starts": {
   "input": {
    "resource": {
     "service.name": "codex-app-server",
     "service.version": "0.119.0",
     "host.name": "dev-host-1"
    },
    "attributes": {
     "conversation.id": "conv_fix_1",
     "app.version": "0.119.0",
     "originator": "Codex_CLI",
     "event.name": "codex.conversation_starts",
     "model": "gpt-5.2-codex",
     "approval_policy": "on-request",
     "sandbox_policy": "workspace-write"
    }
   },
   "companion": {
    "type": "x.codex.otel.conversation_starts",
    "data": {
     "model": "gpt-5.2-codex",
     "approval_policy": "on-request",
     "sandbox_policy": "workspace-write"
    }
   },
   "primary": {
    "type": "session.started",
    "data": {
     "client": {
      "name": "codex"
     },
     "gen_ai.request.model": "gpt-5.2-codex"
    },
    "$comment": "policies stay on the companion family (payload minimalism); the schema-valid core subset only"
   }
  },
  "user_prompt": {
   "input": {
    "resource": {
     "service.name": "codex-app-server",
     "service.version": "0.119.0",
     "host.name": "dev-host-1"
    },
    "attributes": {
     "conversation.id": "conv_fix_1",
     "app.version": "0.119.0",
     "originator": "Codex_CLI",
     "event.name": "codex.user_prompt",
     "prompt": "[REDACTED]",
     "prompt_length": "147"
    }
   },
   "companion": {
    "type": "x.codex.otel.user_prompt",
    "data": {
     "prompt_length": "147"
    },
    "$comment": "prompt content forwards only when the vendor flag AND a redacted+ ceiling both allow (double gate)"
   },
   "primary": {
    "type": "x.codex.otel.user_prompt",
    "data": {
     "prompt_length": "147"
    },
    "$comment": "prompt internals stay vendor-namespaced in BOTH modes (fleet-observer test)"
   }
  },
  "tool_decision_config_deny": {
   "input": {
    "resource": {
     "service.name": "codex-app-server",
     "service.version": "0.119.0",
     "host.name": "dev-host-1"
    },
    "attributes": {
