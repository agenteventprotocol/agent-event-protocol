     "app.version": "0.119.0",
     "originator": "Codex_CLI",
     "event.name": "codex.tool_decision",
     "tool_name": "shell",
     "decision": "deny",
     "source": "config"
    }
   },
   "companion": {
    "type": "x.codex.otel.tool_decision",
    "data": {
     "tool_name": "shell",
     "decision": "deny",
     "source": "config"
    }
   },
   "primary": {
    "type": "tool.denied",
    "data": {
     "tool": {
      "name": "shell"
     },
     "by": "policy"
    },
    "subject": "shell",
    "$comment": "a config deny is a policy block; an automation deny maps by: runtime"
   }
  },
  "tool_decision_user_deny": {
   "input": {
    "resource": {
     "service.name": "codex-app-server",
     "service.version": "0.119.0",
