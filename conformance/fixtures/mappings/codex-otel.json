    },
    "attributes": {
     "conversation.id": "conv_fix_1",
     "app.version": "0.119.0",
     "originator": "Codex_CLI",
     "event.name": "codex.tool_decision",
     "tool_name": "shell",
     "decision": "deny",
     "source": "user"
    }
   },
   "companion": {
    "type": "x.codex.otel.tool_decision",
    "data": {
     "tool_name": "shell",
     "decision": "deny",
     "source": "user"
    }
   },
   "primary": null,
   "$comment": "a user deny is a human decision already made in the CLI, not a policy block — tool.denied would misreport it; primary mode emits nothing (the companion family still carries it for analysis)"
  },
  "tool_result_ok": {
