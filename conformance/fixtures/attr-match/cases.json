{
  "$comment": "attr-match golden corpus (AEP-0003 §6). `match` cases assume the filter is valid; `invalid` filters MUST be rejected (fail closed).",
  "match": [
    { "name": "category glob hits", "filter": { "type": ["attention.*"] },
      "event": { "type": "attention.requested", "session": "s1" }, "match": true },
    { "name": "category glob does not hit prefix-only", "filter": { "type": ["attention.*"] },
      "event": { "type": "tool.completed", "session": "s1" }, "match": false },
    { "name": "exact type", "filter": { "type": "tool.completed" },
      "event": { "type": "tool.completed" }, "match": true },
    { "name": "vendor glob", "filter": { "type": ["x.acme.*"] },
      "event": { "type": "x.acme.foo.bar" }, "match": true },
    { "name": "severity gte hits declared", "filter": { "severity": { "gte": "notice" } },
      "event": { "type": "attention.requested", "severity": "notice" }, "match": true },
    { "name": "severity gte misses default info", "filter": { "severity": { "gte": "notice" } },
      "event": { "type": "tool.completed" }, "match": false },
    { "name": "severity band includes default", "filter": { "severity": { "gte": "debug", "lte": "info" } },
      "event": { "type": "tool.completed" }, "match": true },
    { "name": "agent inclusion", "filter": { "agent": ["claude-code", "codex"] },
      "event": { "type": "run.started", "agent": "claude-code" }, "match": true },
    { "name": "session equality misses other", "filter": { "session": "s_8f2c" },
      "event": { "type": "run.started", "session": "s_other" }, "match": false },
    { "name": "epoch default applies", "filter": { "epoch": 0 },
      "event": { "type": "run.started", "session": "s1" }, "match": true },
    { "name": "absent attribute never matches", "filter": { "step": "turn-3" },
      "event": { "type": "run.started", "session": "s1" }, "match": false },
    { "name": "extension attribute equality", "filter": { "acmeregion": "eu-1" },
      "event": { "type": "run.started", "acmeregion": "eu-1" }, "match": true },
    { "name": "empty filter matches everything", "filter": {},
      "event": { "type": "agent.heartbeat" }, "match": true },
    { "name": "conjunction across keys", "filter": { "type": ["tool.*"], "severity": { "gte": "info" }, "agent": "codex" },
      "event": { "type": "tool.failed", "severity": "warning", "agent": "codex" }, "match": true }
  ],
  "invalid": [
    { "name": "seq not filterable", "filter": { "seq": 5 } },
    { "name": "data not filterable", "filter": { "data": {} } },
    { "name": "time not filterable", "filter": { "time": "2026" } },
    { "name": "aep not filterable", "filter": { "aep": "0.1" } },
    { "name": "traceparent not filterable (core attribute, not an extension key)", "filter": { "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" } },
    { "name": "bare star not a pattern", "filter": { "type": "*" } },
    { "name": "malformed key fails closed (not core, not a legal extension name)", "filter": { "NotAnAttr": "y" } },
    { "name": "gt is not a severity operator", "filter": { "severity": { "gt": "info" } } },
    { "name": "glob on non-type key", "filter": { "agent": "claude*" } },
    { "name": "empty inclusion array", "filter": { "agent": [] } }
  ]
}
